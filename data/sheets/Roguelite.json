  "Keywords": {
    "multistrike": {
      "KEYWORD_NAME": "Multistrike",
      "DESCRIPTION": "Deals DMG multiple times."
    },
    "follow_up": {
      "KEYWORD_NAME": "Follow-up",
      "DESCRIPTION": "A special action that happens immediately after a condition is fulfilled."
    },
    "daze": {
      "KEYWORD_NAME": "Daze",
      "DESCRIPTION": "Dazed enemies deal 20% less DMG and take 30 DMG on turn start."
    },
    "burn": {
      "KEYWORD_NAME": "Burn",
      "DESCRIPTION": "Deals DMG on turn start."
    },
    "mana_crystal": {
      "KEYWORD_NAME": "Mana Crystal",
      "DESCRIPTION": "A 0 cost card. Adds 1 Energy next turn."
    },
    "storm": {
      "KEYWORD_NAME": "Storm",
      "DESCRIPTION": "Adds Lightning DMG as a Follow-up to all DMG you deal. (Scales: DEX)"
    },
    "fortitude": {
      "KEYWORD_NAME": "Fortitude",
      "DESCRIPTION": "Retains armor between turns. On turn start, loses 1 Fortitude."
    },
    "ephemeral": {
      "KEYWORD_NAME": "Ephemeral",
      "DESCRIPTION": "Playing this card removes it from your deck until the end of combat."
    },
